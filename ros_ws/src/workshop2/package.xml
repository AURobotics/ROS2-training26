<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>workshop2</name>
  <version>0.0.1</version>
  <description>
    Workshop 2: GoToPose action server/client (Task 1), parameterized square
    trajectory client (Task 2), launch integration (Task 3), and a SetBool
    serial service (Task 4).
  </description>
  <maintainer email="abdelaziz.islam.galal@gmail.com">abdelaziz</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>turtlesim</depend>
  <depend>std_srvs</depend>
  <depend>turtle_interfaces</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
